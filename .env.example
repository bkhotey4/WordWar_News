DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=b350517c99d9326af65f3339a419ad2b73803ded5c928522fe323b852cc85448
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
COMMANDER_USER_ID=YOUR_DISCORD_USER_ID
PORT=3000
# 只接受本機連線；要讓同網路的手機看網站改成 0.0.0.0
HOST=127.0.0.1
# 執行 npm run setup 會自動產生；呼叫 /api/push-dm 時放在 x-admin-key header
ADMIN_API_KEY=your_secure_admin_api_key_here
# 選填：Cloudflare Radar（對台灣 DDoS 攻擊流量指標）。免費帳號 → My Profile → API Tokens → Create Token，
# 權限 Account.Radar:Read。沒填時該指標顯示「無法判定」，其餘功能不受影響。
CLOUDFLARE_RADAR_TOKEN=
# 選填：Global Fishing Watch API（非商業用途免費）：台灣周邊船舶密度與雷達衛星偵測未開 AIS 的船。
# 註冊帳號後到 https://globalfishingwatch.org/our-apis/tokens 建立 token 貼在這裡。沒填時該指標顯示「無法判定」。
GFW_TOKEN=
# 雲端主控：1 = 巡檢、推播與網站更新由 GitHub Actions 執行，本機只回應斜線指令並同步資料；留空 = 本機自己巡檢
CLOUD_PRIMARY=1
